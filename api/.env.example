# Classic API — miljøvariabler
PORT=3001

# Sti til SQLite-fil (default: api/data/classic.db)
SQLITE_DB_PATH=./data/classic.db

# Kommaseparert liste over tillatte CORS-origins (tom = tillat alle, greit lokalt)
CORS_ORIGINS=

# Valgfritt: server frontend statisk fra samme prosess (sett til ../frontend for én-prosess-drift)
# FRONTEND_DIR=../frontend
